# Database
DATABASE_URL="file:./dev.db"

# Admin
ADMIN_PASSWORD=change-me
CUSTOMER_SIGNUP_ENABLED=true
CUSTOMER_SIGNUP_INITIAL_CREDITS=0

# Project card tool SSO
# Keep secret server-side only. Must match PROJECT_CARD_SSO_SECRET in project-card-tool.
PROJECT_CARD_TOOL_URL=http://127.0.0.1:4173/
PROJECT_CARD_SSO_SECRET=
PROJECT_CARD_SSO_TTL_SECONDS=300
PROJECT_CARD_ENTITLEMENT_DAYS=30

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
GENERATED_DIR=generated

# Optional CDN public base URL
PUBLIC_ASSET_BASE_URL=

# Public launch
PUBLIC_SITE_BASE_URL=
# Public compliance footer. Fill after ICP/public security filing numbers are issued.
SITE_ICP_RECORD_NUMBER=
SITE_ICP_RECORD_URL=https://beian.miit.gov.cn/
SITE_POLICE_RECORD_NUMBER=
SITE_POLICE_RECORD_URL=
# MVP only: allow Launch Readiness to treat SQLite as an accepted testing risk.
# Keep false for formal production.
ALLOW_SQLITE_MVP_TESTING=false
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_SITE_JOB_CREATE_LIMIT=10
PUBLIC_GENERATION_LIMIT=6
SITE_UPLOAD_MAX_FILES=20
SITE_STYLE_REFERENCE_MAX_FILES=8
SITE_UPLOAD_MAX_TOTAL_MB=80

# Generated website publishing layer
# none: keep generated sites in the current storage provider.
# netlify: publish generated static websites to Netlify after preview generation.
SITE_PUBLISH_PROVIDER=none
NETLIFY_AUTH_TOKEN=
NETLIFY_API_BASE_URL=https://api.netlify.com/api/v1
NETLIFY_SITE_NAME_PREFIX=xinyingst-site
# Optional: set to publish every generated website into one existing Netlify site.
# Leave empty to create/reuse one Netlify site per SiteJob.
NETLIFY_SITE_ID=

# Optional lightweight backend for generated sites.
# Keep service-role keys server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_GENERATED_SITE_SCHEMA=public

# Aliyun OSS optional
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_UPLOAD_BUCKET=
ALIYUN_OSS_GENERATED_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_UPLOAD_PUBLIC_BASE_URL=
ALIYUN_OSS_GENERATED_PUBLIC_BASE_URL=
ALIYUN_OSS_PREFIX=ai-website-workbench
ALIYUN_OSS_UPLOAD_PREFIX=uploads
ALIYUN_OSS_GENERATED_PREFIX=generated

# Image Provider
IMAGE_PROVIDER=mock
IMAGE_API_BASE_URL=
IMAGE_API_ENDPOINT=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# Fallback
ENABLE_MOCK_FALLBACK=true

# Shared OpenAI-compatible provider shortcut
# Fill this once, then set STYLE_IMAGE_PROVIDER=openai and COPY_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Stage 4 site style image provider
STYLE_IMAGE_PROVIDER=mock
STYLE_IMAGE_API_BASE_URL=
STYLE_IMAGE_API_ENDPOINT=
STYLE_IMAGE_API_KEY=
STYLE_IMAGE_MODEL=
STYLE_IMAGE_SIZE=1536x1024
STYLE_IMAGE_QUALITY=medium

# Stage 4 site copy provider
COPY_PROVIDER=mock
COPY_API_BASE_URL=
COPY_API_ENDPOINT=
COPY_API_KEY=
COPY_MODEL=

# Final website generator
# codex: call Codex CLI from the worker host.
# remote_html: call a streaming OpenAI-compatible API from the server worker.
# template: use the built-in static HTML generator only.
# worker_queue: web server queues final website generation; a background worker pulls and generates.
SITE_GENERATION_MODE=sync
SITE_GENERATOR_PROVIDER=codex
CODEX_CLI_PATH=
CODEX_SITE_MODEL=
CODEX_SITE_TIMEOUT_MS=600000
CODEX_SITE_REASONING_EFFORT=medium
# Disabled by default. Set true only when an explicit template fallback is acceptable.
SITE_GENERATOR_ENABLE_TEMPLATE_FALLBACK=false
CODEX_PUBLIC_GENERATION_ENABLED=false
REMOTE_SITE_API_BASE_URL=
REMOTE_SITE_API_ENDPOINT=/v1/chat/completions
REMOTE_SITE_API_KEY=
REMOTE_SITE_MODEL=gpt-5.6-sol
REMOTE_SITE_QUALITY_MODE=single_pass
REMOTE_SITE_TIMEOUT_MS=900000
REMOTE_SITE_MAX_OUTPUT_TOKENS=24000
REMOTE_SITE_PLANNING_MAX_TOKENS=8000
REMOTE_SITE_REASONING_EFFORT=
REMOTE_SITE_MAX_IMAGE_INPUTS=12
REMOTE_SITE_MAX_IMAGE_BYTES=8000000
# MVP default: generated websites use direct phone/WeChat contact instead of forms.
SITE_ENABLE_ENHANCED_BACKEND_MODULES=false
# Keep lightweight Netlify deploy manual unless explicitly enabled.
SITE_AUTO_PUBLISH_ON_PREVIEW=false
# off: never block generation/delivery automatically.
# warn: run checks and record warnings without blocking.
# strict: block failed visual QA. Use only when explicitly enabled.
SITE_QUALITY_GATE_MODE=off
# Allow slower low-memory Linux hosts enough time for Chrome DevTools commands.
SITE_QUALITY_CDP_TIMEOUT_MS=120000

# Local pull worker
# Set the same WORKER_SHARED_SECRET on ECS and local worker.
WORKER_SHARED_SECRET=
WORKER_SERVER_BASE_URL=
WORKER_ID=
WORKER_POLL_INTERVAL_MS=8000
WORKER_LEASE_SECONDS=900
