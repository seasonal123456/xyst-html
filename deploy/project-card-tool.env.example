# Copy to /etc/project-card-tool/project-card-tool.env on the ECS.
# Replace secret placeholders on the server only. Never commit the real file.
PROJECT_CARD_ENV=production
HOST=127.0.0.1
PORT=8773

PROJECT_CARD_DATA_DIR=/var/lib/project-card-tool
PROJECT_CARD_STORAGE_DIR=/var/lib/project-card-tool/generated
PROJECT_CARD_LOG_DIR=/var/log/project-card-tool
PROJECT_CARD_TMP_DIR=/var/lib/project-card-tool/tmp

PROJECT_CARD_SSO_ISSUER=ai-site
PROJECT_CARD_SSO_AUDIENCE=project-card-tool
PROJECT_CARD_SSO_SECRET=REPLACE_ON_SERVER

IMAGE_API_BASE_URL=REPLACE_ON_SERVER
IMAGE_API_KEY=REPLACE_ON_SERVER
IMAGE_API_MODEL=gpt-image-2
IMAGE_API_REQUEST_TIMEOUT_MS=260000
IMAGE_API_RETRY_COUNT=3

PROJECT_CARD_ALLOW_DEMO_SESSION=false
PROJECT_CARD_ADMIN_ENABLED=false
PROJECT_CARD_PUBLIC_TRACE_LOOKUP=false
